NODE_ENV=production
PORT=3000
SESSION_CODE=replace-with-a-private-server-side-room-identifier
DEVICE_TOKEN=replace-with-a-rotatable-device-token
CONTROLLER_TOKEN=replace-with-a-strong-controller-token
STUN_URLS=stun:stun.l.google.com:19302
# Optional for signaling-only operation; configure a TURN provider for relayed media.
TURN_URLS=turn:your-turn-host.example:3478?transport=udp
TURN_SHARED_SECRET=replace-with-turn-provider-secret-at-least-32-chars
TURN_CREDENTIAL_TTL_SECONDS=3600
